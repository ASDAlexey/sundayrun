{
  "name": "sundayrun",
  "version": "1.21.0",
  "description": "Воскресный парковый пробег — конвертер Excel-результатов в PDF-протокол с архивом (Angular 22, RU/EN).",
  "scripts": {
    "start": "bun scripts/write-version.ts && bun scripts/build-sitemap.ts && bun scripts/build-sqlite-assets.ts && bun scripts/build-pdf-assets.ts && ng serve",
    "build": "bun scripts/write-version.ts && bun scripts/build-sitemap.ts && bun scripts/build-sqlite-assets.ts && bun scripts/build-pdf-assets.ts && ng build --localize",
    "preview": "bun scripts/preview.ts",
    "measure-course": "bun scripts/measure-course.ts",
    "watch": "ng build --watch --configuration development",
    "test": "bun scripts/run-tests.ts",
    "test:coverage": "bun scripts/run-tests.ts --coverage",
    "test:watch": "ng test --watch",
    "test:merge-coverage": "bun scripts/merge-coverage.ts",
    "generate-i18n": "ng extract-i18n --output-path=src/locale --format=xlf",
    "prettier": "prettier -w \"./src/**/**.(html|scss|ts|json)\" --cache",
    "prettier:check": "prettier -c \"./src/**/**.(html|scss|ts|json)\"",
    "eslint": "eslint .",
    "stylelint": "stylelint \"./src/**/**.scss\" --cache --fix",
    "stylelint:check": "stylelint \"./src/**/**.scss\" --cache",
    "jscpd": "jscpd ./src",
    "madge": "bun ./scripts/check-circular-dependencies.js",
    "check:code-quality": "bun run prettier && concurrently --kill-others-on-fail \"bun run eslint\" \"bun run stylelint:check\"",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/cdk-experimental": "22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "pdfmake": "^0.3.11",
    "rxjs": "~7.8.2",
    "swiper": "^14.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-oxc": "^0.2.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.2.0",
    "@types/pdfmake": "^0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "10.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-local-rules": "file:./eslint-local-plugin",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-rxjs-x": "^1.0.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jpeg-js": "^0.4.4",
    "jscpd": "^5.0.16",
    "madge": "^8.0.0",
    "minimatch": "^10.2.6",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "pretty-quick": "^4.2.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vitest-auto-spy": "^3.0.0"
  }
}
