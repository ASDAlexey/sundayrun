{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/site.webmanifest",
          "/*.css",
          "/main-*.js",
          "/polyfills-*.js",
          "/chunk-*.js",
          "!/ngsw-worker.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js"
        ]
      }
    },
    {
      "name": "on-demand",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.js", "!/ngsw-worker.js", "!/safety-worker.js", "!/worker-basic.min.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/apple-touch-icon.png",
          "/icon-192.png",
          "/icon-512.png",
          "/og-image.jpg",
          "/course-basemap.svg",
          "/fonts/*.woff2"
        ]
      }
    }
  ],
  "index": "/index.html",
  "navigationUrls": ["/", "/timer", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/data/**", "!/pdf/**"]
}
